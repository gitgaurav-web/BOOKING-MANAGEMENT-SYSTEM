PORT=5000
DATABASE_URL="file:./dev.db"

# ==============================================================================
# SECURITY: JWT SECRET KEY
# ==============================================================================
# In production, DO NOT use a static or guessable secret! The server will abort
# startup in production if JWT_SECRET is unset or shorter than 32 characters.
# Generate a cryptographically secure 256-bit random key using either:
#   openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_SECRET="replace_with_your_generated_64_character_hex_secret_key_here"

CLIENT_URL="http://localhost:5173"

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP CONFIGURATION)
# ==============================================================================
# Optional: Configure real SMTP credentials for sending automated booking 
# status emails (submission receipts, admin approvals, rejections, reminders).
# When left blank or in dev mode, outbound email notifications are logged to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Seminar Hall System <noreply@campus.edu>"

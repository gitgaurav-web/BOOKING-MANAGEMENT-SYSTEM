PORT=5000

# ==============================================================================
# DATABASE CONFIGURATION & PERSISTENT STORAGE
# ==============================================================================
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Hosted Cloud Production (e.g. Supabase, Neon, AWS RDS, Railway, Render Postgres):
# When deploying to production platforms with ephemeral filesystems (Render, Heroku, Containers),
# switch provider to postgresql in prisma/schema.prisma and provide your managed DB connection string:
# DATABASE_URL="postgresql://username:password@db-host:5432/facility_db?schema=public"

# ==============================================================================
# UPLOADS & DOCUMENT ATTACHMENTS (PERSISTENT VOLUMES)
# ==============================================================================
# Directory where faculty HOD permission letters and documents are stored.
# In containerized/cloud environments, map this to a persistent volume (e.g. /data/uploads)
# to ensure uploaded permission documents are not wiped on server restarts.
UPLOADS_DIR="./uploads"

# ==============================================================================
# SECURITY: JWT SECRET KEY
# ==============================================================================
# In production, DO NOT use a static or guessable secret! The server will abort
# startup in production if JWT_SECRET is unset, matches placeholder examples, or is shorter than 32 characters.
# Generate a cryptographically secure 256-bit random key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

CLIENT_URL="http://localhost:5173"

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP CONFIGURATION)
# ==============================================================================
# Optional: Configure real SMTP credentials for sending automated booking 
# status emails (submission receipts, admin approvals, rejections, reminders).
# When left blank or in dev mode, outbound email notifications are logged to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sri Sairam Facilities Desk <noreply@sairamce.edu.in>"

# Port for Express API server
PORT=5000

# SQLite (Zero-config local mode)
DATABASE_URL="file:./dev.db"

# PostgreSQL / Supabase (Enterprise Production mode)
# In prisma/schema.prisma: change provider to "postgresql"
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Authentication
JWT_SECRET="sairam-transport-portal-super-secret-jwt-key-2026"

# CORS
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

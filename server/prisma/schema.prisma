// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  passwordHash   String
  phone          String?
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  role           String        @default("USER") // USER, FACULTY, ADMIN, SUPER_ADMIN
  status         String        @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  bookings       Booking[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  vehicleBookings VehicleBooking[]
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  code        String    @unique
  description String?
  status      String    @default("ACTIVE")
  users       User[]
  bookings    Booking[]
  vehicleBookings VehicleBooking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Hall {
  id           String        @id @default(uuid())
  name         String        @unique // Seminar Hall, AV Hall
  code         String        @unique // SEMINAR-HALL-01, AV-HALL-01
  description  String
  location     String
  capacity     Int           // Informational only, no seats
  image        String?
  facilities   String        // JSON string of amenities
  status       String        @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  blockedDates BlockedDate[]
  maintenances Maintenance[]
}

model Booking {
  id                  String      @id @default(uuid())
  bookingId           String      @unique // e.g. HB-2026-0001
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  hallId              String
  hall                Hall        @relation(fields: [hallId], references: [id])
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  eventName           String
  description         String?
  purpose             String
  requestedBy         String
  coordinatorName     String?
  contactNumber       String
  email               String
  bookingDate         String      // YYYY-MM-DD (Start Date)
  endDate             String?     // YYYY-MM-DD (Optional End Date for multi-day bookings)
  bookingType         String      @default("FULL_DAY") // FULL_DAY, MORNING, AFTERNOON, CUSTOM
  startTime           String      @default("09:00")
  endTime             String      @default("17:00")
  participantCount    Int         @default(0) // Informational only
  guestCount          Int?        @default(0) // VIP / Dignitary Guest count
  mementoCount        Int?        @default(0) // Mementos count
  specialRequirements String?     // JSON string of requirements
  attachmentUrl       String?     // PDF or permission document link
  additionalNotes     String?
  status              String      @default("PENDING") // PENDING, APPROVED (BOOKED), REJECTED, CANCELLED
  adminNotes          String?
  approvedById        String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model BlockedDate {
  id          String   @id @default(uuid())
  hallId      String?  // null if all halls blocked
  hall        Hall?    @relation(fields: [hallId], references: [id])
  startDate   String   // YYYY-MM-DD
  endDate     String   // YYYY-MM-DD
  reason      String   // MAINTENANCE, EXAMINATION, OFFICIAL_EVENT, HOLIDAY, EMERGENCY, OTHER
  description String?
  createdById String?
  createdAt   DateTime @default(now())
}

model Maintenance {
  id                String   @id @default(uuid())
  hallId            String
  hall              Hall     @relation(fields: [hallId], references: [id])
  startDate         String   // YYYY-MM-DD
  endDate           String   // YYYY-MM-DD
  reason            String
  notes             String?
  responsiblePerson String?
  createdAt         DateTime @default(now())
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        String   // YYYY-MM-DD
  description String?
  hallScope   String   @default("ALL") // ALL, SEMINAR_HALL, AV_HALL
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  description String
  createdAt   DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Vehicle {
  id              String            @id @default(uuid())
  name            String            // e.g. Ashok Leyland College Bus 07, Innova Staff Car, Force Traveller
  registrationNo  String            @unique // e.g. KA-51-E-7707
  vehicleType     String            // BUS, CAR, VAN, AMBULANCE
  capacity        Int               // Total passenger seating capacity
  fuelType        String            // DIESEL, PETROL, EV, CNG
  acAvailable     Boolean           @default(false)
  image           String?
  features        String            // JSON array string: GPS, First Aid, Speed Governor, PA System
  status          String            @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  driverName      String?
  driverPhone     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookings        VehicleBooking[]
}

model VehicleBooking {
  id                  String      @id @default(uuid())
  bookingId           String      @unique // e.g. BUS-NOV26-001, CAR-NOV26-002
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  vehicleId           String
  vehicle             Vehicle     @relation(fields: [vehicleId], references: [id])
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  tripTitle           String      // e.g. Industrial Visit to ISRO Bengaluru
  pickupLocation      String      // e.g. College Campus Gate 1
  dropLocation        String      // Destination / Route
  passengerCount      Int         @default(1)
  tripPurpose         String      // INDUSTRIAL_VISIT, GUEST_TRANSFER, SPORTS_MEET, CONFERENCE, EMERGENCY
  coordinatorName     String      // Faculty coordinator
  coordinatorPhone    String      // Phone
  email               String
  startDate           String      // YYYY-MM-DD
  endDate             String?     // YYYY-MM-DD
  departureTime       String      // HH:mm
  returnTime          String      // HH:mm
  estimatedKilometers Int?        @default(0)
  tollPaymentRequired Boolean     @default(false)
  specialRequirements String?     // JSON array
  attachmentUrl       String?     // HOD letter PDF
  additionalNotes     String?
  status              String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED, COMPLETED
  assignedDriverName  String?
  assignedDriverPhone String?
  adminNotes          String?
  approvedById        String?
  approvedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

